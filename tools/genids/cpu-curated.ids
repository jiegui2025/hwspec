# Hand-curated CPU codenames, applied on top of what genids derives from the
# Linux kernel (intel-family.h model numbers, amd.c Zen generation ranges).
#
# Format: VENDOR FAMILY MODEL [STEPPINGS]<TAB>Codename<TAB>Microarchitecture<TAB>Sources
# Family and model in hex, steppings in decimal ("10-13" or "9").
# An empty codename or microarchitecture keeps the generated value.
#
# Every line names at least one source a reviewer can open, space-separated
# (genids refuses a line without one, and warns about a line that changes
# nothing the kernel doesn't already say):
#   kernel:PATH[#SYMBOL]  a file in torvalds/linux
#   instlat:FILE          a CPUID dump in github.com/InstLatx64/InstLatx64,
#                         named <Vendor><CPUID 1 EAX>_<codename>_CPUID.txt
#   amd:URL, intel:URL    the vendor's own documentation (https:// URLs)
#   url:URL               anything else (an https:// URL)
# Never guess: a name without a source is left out. Corrections are welcome
# as pull requests, with a source.

# Intel: the kernel lists one name per model number, but some model numbers
# span several codenames, told apart by stepping. Intel's microcode release
# notes list each stepping's products (abbreviated: AML Amber Lake, CFL
# Coffee Lake, CLX Cascade Lake, CML Comet Lake, CPX Cooper Lake, KBL-R Kaby
# Lake R, WHL Whiskey Lake).
intel 6 9e 10-13	Coffee Lake	Skylake	kernel:arch/x86/include/asm/intel-family.h#COFFEELAKE instlat:GenuineIntel/GenuineIntel00906EA_Coffeelake_CPUID.txt intel:https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/blob/main/releasenote.md
intel 6 8e 9	Kaby Lake / Amber Lake	Skylake	kernel:arch/x86/include/asm/intel-family.h#AMBERLAKE_L instlat:GenuineIntel/GenuineIntel00806E9_Kabylake_CPUID.txt instlat:GenuineIntel/GenuineIntel00806E9_AmberLakeY_CPUID.txt intel:https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/blob/main/releasenote.md
intel 6 8e 10	Kaby Lake R / Coffee Lake	Skylake	kernel:arch/x86/include/asm/intel-family.h#COFFEELAKE_L instlat:GenuineIntel/GenuineIntel00806EA_Kabylake_CPUID.txt intel:https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/blob/main/releasenote.md
intel 6 8e 11	Whiskey Lake	Skylake	kernel:arch/x86/include/asm/intel-family.h#WHISKEYLAKE_L instlat:GenuineIntel/GenuineIntel00806EB_WhiskeyLake_CPUID.txt
# The kernel says Whiskey Lake only; Intel lists WHL-U, CML-U42, CML-Y42 and
# AML-Y42 at 06-8e-0c, and the dumps there are Comet Lake (i5-10210U).
intel 6 8e 12	Whiskey Lake / Comet Lake / Amber Lake	Skylake	kernel:arch/x86/include/asm/intel-family.h#WHISKEYLAKE_L instlat:GenuineIntel/GenuineIntel00806EC_CometLake_CPUID2.txt intel:https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/blob/main/releasenote.md
# Intel lists Cascade Lake at steppings 5, 6 and 7 (the kernel names 7).
intel 6 55 5-7	Cascade Lake-X	Skylake	kernel:arch/x86/include/asm/intel-family.h#CASCADELAKE_X instlat:GenuineIntel/GenuineIntel0050657_CascadeLakeSP_CPUID1.txt instlat:GenuineIntel/GenuineIntel0050656_CascadeLakeSP_CPUID.txt intel:https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/blob/main/releasenote.md
intel 6 55 11	Cooper Lake-X	Skylake	kernel:arch/x86/include/asm/intel-family.h#COOPERLAKE_X intel:https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/blob/main/releasenote.md

# AMD family 17h (Zen, Zen+, Zen 2). The kernel gives only the Zen
# generation (amd.c); codenames come from AMD's revision guides, kernel
# comments and the InstLatx64 dumps. AMD's revision guide 55449 lists
# Ryzen at 00800F11h and EPYC at 00800F12h.
amd 17 01	Summit Ridge / Naples	Zen	amd:https://docs.amd.com/api/khub/documents/abOrVU_gcO7ZsC3qDF4uNQ/content url:https://github.com/torvalds/linux/commit/2770d4722036
amd 17 08	Pinnacle Ridge	Zen+	amd:https://docs.amd.com/api/khub/documents/abOrVU_gcO7ZsC3qDF4uNQ/content instlat:AuthenticAMD/AuthenticAMD0800F82_K17_PinnacleRidge_01_CPUID.txt kernel:drivers/hwmon/k10temp.c
amd 17 11	Raven Ridge / Great Horned Owl	Zen	url:https://github.com/torvalds/linux/commit/f9bc6b2dd9cf kernel:drivers/hwmon/k10temp.c instlat:AuthenticAMD/AuthenticAMD0810F10_K17_Zen_CPUID.txt instlat:AuthenticAMD/AuthenticAMD0810F10_K17_GreatHornedOwl_CPUID.txt
amd 17 18	Picasso	Zen+	instlat:AuthenticAMD/AuthenticAMD0810F81_K17_Picasso_CPUID.txt kernel:drivers/hwmon/k10temp.c
amd 17 20	Dali	Zen	instlat:AuthenticAMD/AuthenticAMD0820F01_K17_Dali_CPUID.txt
amd 17 31	Rome / Castle Peak	Zen 2	instlat:AuthenticAMD/AuthenticAMD0830F10_K17_Rome_CPUID.txt instlat:AuthenticAMD/AuthenticAMD0830F10_K17_CastlePeak_CPUID.txt
amd 17 60	Renoir	Zen 2	instlat:AuthenticAMD/AuthenticAMD0860F01_K17_Renoir_CPUID2.txt
amd 17 68	Lucienne	Zen 2	instlat:AuthenticAMD/AuthenticAMD0860F81_K17_Lucienne_CPUID04.txt
amd 17 71	Matisse	Zen 2	instlat:AuthenticAMD/AuthenticAMD0870F10_K17_Matisse_CPUID.txt
amd 17 90	Van Gogh	Zen 2	instlat:AuthenticAMD/AuthenticAMD0890F02_K17_VanGogh_01_CPUID.txt
