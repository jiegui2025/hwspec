{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema names the advice document's JSON Schema (schema.AdviceURL)."
    },
    "advice_version": {
      "type": "integer"
    },
    "kb_version": {
      "type": "string"
    },
    "capture_sha256": {
      "type": "string",
      "description": "CaptureSHA256 identifies the advised content, not a file: SHA-256 of the capture as this build reads it (fields it doesn't know are dropped), after --redact, encoded as compact JSON. The JSON and YAML of one capture agree; it isn't `sha256sum FILE`."
    },
    "live": {
      "type": "boolean",
      "description": "Live is true when the capture is of the machine running advise, so its maintenance state could be used."
    },
    "redacted": {
      "type": "boolean"
    },
    "rules_applied": {
      "type": "integer",
      "description": "RulesApplied and RulesSkipped count the knowledge base's rules: no findings means nothing was found by the applied ones only."
    },
    "rules_skipped": {
      "type": "integer"
    },
    "warnings": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "the rule's ID"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "device": {
            "type": [
              "null",
              "object"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "description": "for people; matching never uses it"
              }
            },
            "description": "DeviceRef names a device by the key its kind uses in captures: a PCI address, a USB bus-device, a disk's name.",
            "required": [
              "kind",
              "key"
            ]
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "evidence": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "absent": {
                  "type": "boolean",
                  "const": true
                },
                "path": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\[[0-9]+\\])?(\\.[a-z][a-z0-9_]*(\\[[0-9]+\\])?)*$"
                },
                "value": true
              },
              "required": [
                "path"
              ],
              "oneOf": [
                {
                  "required": [
                    "value"
                  ],
                  "not": {
                    "required": [
                      "absent"
                    ]
                  }
                },
                {
                  "required": [
                    "absent"
                  ],
                  "not": {
                    "required": [
                      "value"
                    ]
                  }
                }
              ]
            },
            "description": "Evidence is a capture value that triggered a finding, by its path in the capture's JSON (e.g. \"pci[16].class_code\"), or a field the capture doesn't have. It is written as exactly {path, value} or {path, absent: true}. Never an identity, serial, UUID, MAC or hostname field."
          },
          "answers": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "topic": {
                  "type": "string"
                },
                "known": {
                  "type": "boolean"
                },
                "text": {
                  "type": "string"
                },
                "claims": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": true,
                      "src": {
                        "type": "string"
                      },
                      "published": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "value",
                      "src"
                    ]
                  },
                  "description": "AnswerClaim is one source's value behind an answer, with the date of its document."
                }
              },
              "required": [
                "topic",
                "known",
                "text"
              ]
            },
            "description": "Answers are an upgrade finding's answers (#9): memory's are #107's."
          },
          "actions": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "distro": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "commands": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "risk": {
                  "type": "string"
                },
                "undo": {
                  "type": "string"
                }
              },
              "required": [
                "text"
              ]
            },
            "description": "Action is what the user can do about a finding: what can go wrong, and how to go back. Commands are shown, never run."
          },
          "sources": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "mirror": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "doc": {
                  "type": "string"
                },
                "edition": {
                  "type": "string"
                },
                "published": {
                  "type": "string"
                },
                "retrieved": {
                  "type": "string"
                },
                "licence": {
                  "type": "string"
                },
                "confidence": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "url",
                "retrieved",
                "licence",
                "confidence"
              ]
            },
            "description": "Source is a document a finding rests on, as the advice shows it."
          },
          "confidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "category",
          "severity",
          "title",
          "sources",
          "confidence"
        ]
      },
      "description": "Finding is one piece of advice about one device, or the whole machine. A finding is identified by its rule ID and its device's kind and key."
    }
  },
  "$id": "https://raw.githubusercontent.com/jiegui2025/hwspec/main/schema/advice-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hwspec advice, advice_version 1",
  "description": "Generated from internal/advisor by tools/genschema: don't edit by hand.",
  "required": [
    "advice_version",
    "kb_version",
    "capture_sha256",
    "live",
    "redacted",
    "rules_applied",
    "rules_skipped",
    "warnings",
    "findings"
  ]
}
